// =============================================================================
// CUSTOWORKS CAR RENTAL – Database schema (PostgreSQL + Prisma)
// -----------------------------------------------------------------------------
// Notes
//  * All money values are stored as DECIMAL(12,2) (PHP / ₱).
//  * All timestamps are stored as timestamptz (UTC) and rendered in Asia/Manila.
//  * Soft deletion (deleted_at) is used for users, vehicles, destinations,
//    additional fees and payment methods so historical bookings stay intact.
//  * Double-booking protection is enforced at the DATABASE level with a
//    PostgreSQL EXCLUDE constraint (see migration 0001_init, raw SQL section)
//    in addition to transactional advisory locks in the booking service.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum VehicleCategory {
  SEDAN
  SUV_MPV
  VAN
}

enum Transmission {
  AT
  MT
}

enum VehicleStatus {
  AVAILABLE
  UNAVAILABLE
  MAINTENANCE
}

enum RentalType {
  SELF_DRIVE
  WITH_DRIVER
}

/// Rate plans that appear on the Custoworks rate cards.
enum RateDuration {
  HOURS_12 // flat amount for up to 12 hours
  HOURS_24 // amount per 24-hour day
  WEEKLY // per-day amount applied when the rental is 7 days or longer
  MONTHLY // per-day amount applied when the rental is 30 days or longer
  MONTHLY_UNLI // unlimited-mileage monthly plan (unit defined by pricing_unit)
}

enum PricingUnit {
  FLAT // amount covers the whole block (e.g. 12 hours, or 30 days for MONTHLY_UNLI)
  PER_DAY // amount multiplied by number of 24-hour days
}

enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  PAYMENT_VERIFICATION
  PENDING_REQUIREMENTS
  REQUIREMENTS_REVIEW
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
  REJECTED
  EXPIRED
}

enum RequirementAppliesTo {
  SELF_DRIVE
  WITH_DRIVER
  BOTH
}

enum RequirementStatus {
  NOT_SUBMITTED
  SUBMITTED
  APPROVED
  REJECTED
  REUPLOAD_REQUESTED
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

enum ReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
  REUPLOAD_REQUESTED
}

/// Payment categories are intentionally separated: the reservation fee and the
/// refundable security deposit are NEVER combined into one category.
enum PaymentType {
  RESERVATION_FEE
  RENTAL_BALANCE
  SECURITY_DEPOSIT
  SECURITY_DEPOSIT_REFUND
  ADDITIONAL_CHARGE
  REFUND
}

enum PaymentStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
  VOIDED
}

enum PaymentMethodKind {
  BANK_TRANSFER
  E_WALLET
  CASH
  ONLINE_GATEWAY
}

enum FeeType {
  DELIVERY // delivery zone fee (choose one)
  DELIVERY_SURCHARGE // extra charge for far locations (added on top of zone fee)
  CARWASH // per vehicle category
  OTHER
}

enum DiscountType {
  PERCENT
  FIXED
}

enum AvailabilityBlockType {
  MAINTENANCE
  BLOCKED
}

enum BookingRequestType {
  RESCHEDULE
  CANCELLATION
}

enum BookingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ----------------------------------------------------------------------------
// Users & auth
// ----------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  phone        String?
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  profile            CustomerProfile?
  refreshTokens      RefreshToken[]
  bookings           Booking[]           @relation("BookingCustomer")
  paymentsSubmitted  Payment[]           @relation("PaymentSubmittedBy")
  paymentsVerified   Payment[]           @relation("PaymentVerifiedBy")
  documentsUploaded  RequirementDocument[]
  requirementReviews RequirementReview[]
  notes              BookingNote[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  availabilityBlocks VehicleAvailability[]
  statusChanges      BookingStatusHistory[]
  bookingRequests    BookingRequest[]    @relation("BookingRequestBy")
  requestsHandled    BookingRequest[]    @relation("BookingRequestHandledBy")

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model CustomerProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  address               String?
  city                  String?
  province              String?
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")
  emergencyContactRelation String? @map("emergency_contact_relation")
  birthDate             DateTime? @map("birth_date") @db.Date
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

// ----------------------------------------------------------------------------
// Fleet & pricing
// ----------------------------------------------------------------------------

model Vehicle {
  id              String          @id @default(uuid()) @db.Uuid
  slug            String          @unique
  name            String
  category        VehicleCategory
  make            String
  model           String
  year            Int?
  transmission    Transmission
  seats           Int
  fuelType        String?         @map("fuel_type")
  color           String?
  plateNumber     String?         @unique @map("plate_number")
  description     String?
  features        String[]        @default([])
  allowSelfDrive  Boolean         @default(true) @map("allow_self_drive")
  allowWithDriver Boolean         @default(true) @map("allow_with_driver")
  status          VehicleStatus   @default(AVAILABLE)
  isPublished     Boolean         @default(true) @map("is_published")
  isFeatured      Boolean         @default(false) @map("is_featured")
  sortOrder       Int             @default(0) @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?       @map("deleted_at") @db.Timestamptz

  images       VehicleImage[]
  rates        VehicleRate[]
  bookings     Booking[]
  availability VehicleAvailability[]
  promotions   Promotion[]

  @@index([category])
  @@index([status, isPublished])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  url       String
  storageKey String? @map("storage_key")
  altText   String?  @map("alt_text")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model Destination {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  name        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  rates    VehicleRate[]
  bookings Booking[]

  @@map("destinations")
}

/// One row per (vehicle, destination, rental type, rate plan).
/// amount = NULL means "not yet provided" – such rates are never offered to
/// customers. Rates must also be explicitly published by an administrator.
model VehicleRate {
  id            String       @id @default(uuid()) @db.Uuid
  vehicleId     String       @map("vehicle_id") @db.Uuid
  destinationId String       @map("destination_id") @db.Uuid
  rentalType    RentalType   @map("rental_type")
  duration      RateDuration
  pricingUnit   PricingUnit  @default(PER_DAY) @map("pricing_unit")
  amount        Decimal?     @db.Decimal(12, 2)
  isPublished   Boolean      @default(false) @map("is_published")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  vehicle     Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, destinationId, rentalType, duration])
  @@index([destinationId])
  @@map("vehicle_rates")
}

model Promotion {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  code         String?      @unique
  description  String?
  discountType DiscountType @map("discount_type")
  value        Decimal      @db.Decimal(12, 2)
  vehicleId    String?      @map("vehicle_id") @db.Uuid
  rentalType   RentalType?  @map("rental_type")
  minDays      Int?         @map("min_days")
  startsAt     DateTime?    @map("starts_at") @db.Timestamptz
  endsAt       DateTime?    @map("ends_at") @db.Timestamptz
  autoApply    Boolean      @default(false) @map("auto_apply")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@map("promotions")
}

model AdditionalFee {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  description     String?
  type            FeeType
  amount          Decimal          @db.Decimal(12, 2)
  vehicleCategory VehicleCategory? @map("vehicle_category")
  isActive        Boolean          @default(true) @map("is_active")
  sortOrder       Int              @default(0) @map("sort_order")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamptz

  bookingFees BookingFee[]

  @@index([type, isActive])
  @@map("additional_fees")
}

/// Manual availability blocks (maintenance, owner use, etc.).
model VehicleAvailability {
  id          String                @id @default(uuid()) @db.Uuid
  vehicleId   String                @map("vehicle_id") @db.Uuid
  type        AvailabilityBlockType @default(MAINTENANCE)
  startAt     DateTime              @map("start_at") @db.Timestamptz
  endAt       DateTime              @map("end_at") @db.Timestamptz
  reason      String?
  createdById String?               @map("created_by_id") @db.Uuid
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  deletedAt   DateTime?             @map("deleted_at") @db.Timestamptz

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([vehicleId, startAt, endAt])
  @@map("vehicle_availability")
}

// ----------------------------------------------------------------------------
// Bookings
// ----------------------------------------------------------------------------

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique
  customerId    String        @map("customer_id") @db.Uuid
  vehicleId     String        @map("vehicle_id") @db.Uuid
  destinationId String        @map("destination_id") @db.Uuid
  promotionId   String?       @map("promotion_id") @db.Uuid
  rentalType    RentalType    @map("rental_type")
  pickupAt      DateTime      @map("pickup_at") @db.Timestamptz
  returnAt      DateTime      @map("return_at") @db.Timestamptz
  status        BookingStatus @default(DRAFT)
  holdExpiresAt DateTime?     @map("hold_expires_at") @db.Timestamptz

  // Customer snapshot (kept even if the profile changes later)
  customerName          String  @map("customer_name")
  customerEmail         String  @map("customer_email")
  customerPhone         String  @map("customer_phone")
  customerAddress       String? @map("customer_address")
  emergencyContactName  String? @map("emergency_contact_name")
  emergencyContactPhone String? @map("emergency_contact_phone")
  purpose               String?

  // Logistics
  pickupMethod    String  @default("OFFICE") @map("pickup_method") // OFFICE | DELIVERY
  deliveryAddress String? @map("delivery_address")
  includeCarwash  Boolean @default(true) @map("include_carwash")

  // Pricing snapshot (server-calculated, never customer-provided)
  ratePlan        RateDuration @map("rate_plan")
  rentalDays      Int          @map("rental_days")
  rentalHours     Int          @map("rental_hours")
  rentalFee       Decimal      @map("rental_fee") @db.Decimal(12, 2)
  deliveryFee     Decimal      @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  carwashFee      Decimal      @default(0) @map("carwash_fee") @db.Decimal(12, 2)
  otherFees       Decimal      @default(0) @map("other_fees") @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(12, 2)
  reservationFee  Decimal      @map("reservation_fee") @db.Decimal(12, 2)
  pricingBreakdown Json        @map("pricing_breakdown")

  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz
  releasedAt      DateTime? @map("released_at") @db.Timestamptz
  returnedAt      DateTime? @map("returned_at") @db.Timestamptz
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason    String?   @map("cancel_reason")
  rejectReason    String?   @map("reject_reason")
  reminderSentAt  DateTime? @map("reminder_sent_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer      User                   @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  vehicle       Vehicle                @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  destination   Destination            @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  promotion     Promotion?             @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  fees          BookingFee[]
  requirements  BookingRequirement[]
  payments      Payment[]
  agreement     RentalAgreement?
  notes         BookingNote[]
  statusHistory BookingStatusHistory[]
  requests      BookingRequest[]
  notifications Notification[]

  @@index([customerId])
  @@index([vehicleId, pickupAt, returnAt])
  @@index([status])
  @@index([holdExpiresAt])
  @@map("bookings")
}

/// Fee line items (delivery, surcharge, carwash, ...) snapshotted per booking.
model BookingFee {
  id              String   @id @default(uuid()) @db.Uuid
  bookingId       String   @map("booking_id") @db.Uuid
  additionalFeeId String?  @map("additional_fee_id") @db.Uuid
  type            FeeType
  name            String
  amount          Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  additionalFee AdditionalFee? @relation(fields: [additionalFeeId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_fees")
}

model BookingStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  note       String?
  actorId    String?        @map("actor_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_status_history")
}

model BookingNote {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("booking_notes")
}

model BookingRequest {
  id                String               @id @default(uuid()) @db.Uuid
  bookingId         String               @map("booking_id") @db.Uuid
  type              BookingRequestType
  status            BookingRequestStatus @default(PENDING)
  requestedPickupAt DateTime?            @map("requested_pickup_at") @db.Timestamptz
  requestedReturnAt DateTime?            @map("requested_return_at") @db.Timestamptz
  reason            String?
  adminResponse     String?              @map("admin_response")
  requestedById     String               @map("requested_by_id") @db.Uuid
  handledById       String?              @map("handled_by_id") @db.Uuid
  handledAt         DateTime?            @map("handled_at") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("BookingRequestBy", fields: [requestedById], references: [id], onDelete: Restrict)
  handledBy   User?   @relation("BookingRequestHandledBy", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@map("booking_requests")
}

// ----------------------------------------------------------------------------
// Rental requirements
// ----------------------------------------------------------------------------

/// Admin-configurable catalogue of documents (LTMS QR, licenses, IDs, selfie...).
model RequirementType {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  name        String
  description String?
  appliesTo   RequirementAppliesTo @map("applies_to")
  isRequired  Boolean              @default(true) @map("is_required")
  /// Optional sub-choices (e.g. accepted secondary IDs).
  options     String[]             @default([])
  isActive    Boolean              @default(true) @map("is_active")
  sortOrder   Int                  @default(0) @map("sort_order")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  bookingRequirements BookingRequirement[]

  @@map("requirement_types")
}

/// Checklist entry per booking (snapshotted from requirement_types at booking time).
model BookingRequirement {
  id                String            @id @default(uuid()) @db.Uuid
  bookingId         String            @map("booking_id") @db.Uuid
  requirementTypeId String            @map("requirement_type_id") @db.Uuid
  name              String
  isRequired        Boolean           @default(true) @map("is_required")
  status            RequirementStatus @default(NOT_SUBMITTED)
  rejectionReason   String?           @map("rejection_reason")
  reviewedAt        DateTime?         @map("reviewed_at") @db.Timestamptz
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  booking         Booking               @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requirementType RequirementType       @relation(fields: [requirementTypeId], references: [id], onDelete: Restrict)
  documents       RequirementDocument[]
  reviews         RequirementReview[]

  @@unique([bookingId, requirementTypeId])
  @@map("booking_requirements")
}

/// Uploaded files. storage_key is a PRIVATE key – files are only served through
/// the authenticated /api/files endpoint (never via a public URL).
model RequirementDocument {
  id                   String         @id @default(uuid()) @db.Uuid
  bookingRequirementId String         @map("booking_requirement_id") @db.Uuid
  uploadedById         String         @map("uploaded_by_id") @db.Uuid
  storageProvider      String         @map("storage_provider")
  storageKey           String         @map("storage_key")
  originalName         String         @map("original_name")
  mimeType             String         @map("mime_type")
  sizeBytes            Int            @map("size_bytes")
  selectedOption       String?        @map("selected_option") // e.g. "Passport"
  status               DocumentStatus @default(PENDING_REVIEW)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz

  bookingRequirement BookingRequirement  @relation(fields: [bookingRequirementId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  reviews            RequirementReview[]

  @@index([bookingRequirementId])
  @@map("requirement_documents")
}

model RequirementReview {
  id                   String       @id @default(uuid()) @db.Uuid
  bookingRequirementId String       @map("booking_requirement_id") @db.Uuid
  documentId           String?      @map("document_id") @db.Uuid
  action               ReviewAction
  reason               String?
  actorId              String       @map("actor_id") @db.Uuid
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz

  bookingRequirement BookingRequirement   @relation(fields: [bookingRequirementId], references: [id], onDelete: Cascade)
  document           RequirementDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  actor              User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([bookingRequirementId])
  @@map("requirement_reviews")
}

// ----------------------------------------------------------------------------
// Payments
// ----------------------------------------------------------------------------

model PaymentMethod {
  id            String            @id @default(uuid()) @db.Uuid
  code          String            @unique // BPI | BDO | GCASH | CASH | (future gateway)
  name          String
  kind          PaymentMethodKind
  accountName   String?           @map("account_name")
  accountNumber String?           @map("account_number")
  instructions  String?
  qrImageUrl    String?           @map("qr_image_url")
  isCustomerSelectable Boolean    @default(true) @map("is_customer_selectable")
  isActive      Boolean           @default(true) @map("is_active")
  sortOrder     Int               @default(0) @map("sort_order")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz

  payments Payment[]

  @@map("payment_methods")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  paymentMethodId String        @map("payment_method_id") @db.Uuid
  type            PaymentType
  status          PaymentStatus @default(PENDING_VERIFICATION)
  amount          Decimal       @db.Decimal(12, 2)
  referenceNumber String?       @map("reference_number")
  proofStorageProvider String?  @map("proof_storage_provider")
  proofStorageKey String?       @map("proof_storage_key")
  proofMimeType   String?       @map("proof_mime_type")
  receiptNumber   String?       @unique @map("receipt_number")
  notes           String?
  rejectionReason String?       @map("rejection_reason")
  idempotencyKey  String?       @unique @map("idempotency_key")

  // Reserved for a future online payment gateway (PayMongo, Xendit, ...)
  gatewayProvider  String? @map("gateway_provider")
  gatewayPaymentId String? @unique @map("gateway_payment_id")
  gatewayStatus    String? @map("gateway_status")
  gatewayPayload   Json?   @map("gateway_payload")

  submittedById String?   @map("submitted_by_id") @db.Uuid
  verifiedById  String?   @map("verified_by_id") @db.Uuid
  paidAt        DateTime? @map("paid_at") @db.Timestamptz
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  submittedBy   User?         @relation("PaymentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  verifiedBy    User?         @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@index([type])
  @@map("payments")
}

// ----------------------------------------------------------------------------
// Agreements, notifications, settings, audit
// ----------------------------------------------------------------------------

model RentalAgreement {
  id              String    @id @default(uuid()) @db.Uuid
  bookingId       String    @unique @map("booking_id") @db.Uuid
  agreementNumber String    @unique @map("agreement_number")
  termsSnapshot   String    @map("terms_snapshot")
  generatedAt     DateTime  @default(now()) @map("generated_at") @db.Timestamptz
  acceptedAt      DateTime? @map("accepted_at") @db.Timestamptz
  acceptedIp      String?   @map("accepted_ip")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("rental_agreements")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String?             @map("user_id") @db.Uuid
  bookingId String?             @map("booking_id") @db.Uuid
  channel   NotificationChannel
  type      String
  recipient String?
  subject   String
  body      String
  status    NotificationStatus  @default(PENDING)
  error     String?
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz
  readAt    DateTime?           @map("read_at") @db.Timestamptz
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([bookingId])
  @@map("notifications")
}

/// Key/value business settings (reservation fee, hold windows, policies, contact info).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// Tie-Up Partner Fleet Program (80% Partner / 20% Custoworks Management Fee)
// ----------------------------------------------------------------------------

enum PartnerStatus {
  PENDING
  CONTACTED
  APPROVED
  REJECTED
}

model PartnerApplication {
  id                    String        @id @default(uuid()) @db.Uuid
  fullName              String        @map("full_name")
  phone                 String
  email                 String
  city                  String        @default("Naga City")
  vehicleMake           String        @map("vehicle_make")
  vehicleModel          String        @map("vehicle_model")
  year                  Int
  transmission          Transmission  @default(AT)
  category              VehicleCategory @default(SEDAN)
  plateNumber           String?       @map("plate_number")
  rentalTypePreference  RentalType    @default(SELF_DRIVE) @map("rental_type_preference")
  partnerSharePercent   Decimal       @default(80.00) @map("partner_share_percent") @db.Decimal(5, 2)
  custoworksFeePercent  Decimal       @default(20.00) @map("custoworks_fee_percent") @db.Decimal(5, 2)
  status                PartnerStatus @default(PENDING)
  notes                 String?
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([createdAt])
  @@map("partner_applications")
}

